@model SubBill.Models.Payment
@{
    ViewData["Title"] = "Payment Checkout";
    var plan = ViewBag.Plan as SubBill.Models.SubscriptionPlan;
    var razorpayKey = ViewBag.RazorpayKey as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Secure Payment Checkout (Razorpay Test Sandbox)</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <h5 class="mb-1">@plan?.Name Subscription</h5>
                            <span class="text-muted">Billing Cycle: @plan?.BillingCycle</span>
                        </div>
                        <div class="text-end">
                            <h4 class="text-primary mb-0">@Model.Currency @Model.Amount.ToString("F2")</h4>
                            <small class="text-muted">Total Payable</small>
                        </div>
                    </div>

                    <div class="alert alert-info py-2">
                        <small>
                            <strong>Sandbox Mode:</strong> Razorpay Gateway Integration. Key ID: <code>@razorpayKey</code> | Order ID: <code>@Model.OrderId</code>
                        </small>
                    </div>

                    <!-- Payment Submission Form -->
                    <form id="paymentForm" asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" id="paymentId" name="paymentId" value="pay_test_@Guid.NewGuid().ToString("N")[..12]" />
                        <input type="hidden" id="signature" name="signature" value="test_signature_valid" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Payment Method</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="paymentMethod" id="cardMethod" checked>
                                    <label class="form-check-label" for="cardMethod">
                                        Test Card / NetBanking / UPI (Simulated Gateway)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                Complete Payment (@Model.Currency @Model.Amount.ToString("F2"))
                            </button>
                            <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 text-muted small">
                    <i class="bi bi-shield-lock"></i> 256-bit encrypted test transaction. Real money will NOT be charged.
                </div>
            </div>
        </div>
    </div>
</div>
