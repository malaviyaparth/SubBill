@model List<SubBill.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Subscription Plans Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-collection me-2 text-primary"></i>Subscription Plans</h2>
            <p class="text-muted mb-0">Create, configure, and manage subscription tiers, billing cycles, features, and free trials.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>New Plan
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">All Configured Plans (@Model.Count)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Plan Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Billing Cycle</th>
                            <th>Free Trial</th>
                            <th>Features</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@plan.Name</div>
                                    <small class="text-muted">ID: #@plan.Id</small>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(plan.Description) ? "No description provided" : plan.Description)</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary fs-6">@plan.Price.ToString("C")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@plan.BillingCycle</span>
                                </td>
                                <td>
                                    @if (plan.TrialDays > 0)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                            <i class="bi bi-gift me-1"></i>@plan.TrialDays Days Trial
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No trial</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Features" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-primary position-relative">
                                        <i class="bi bi-list-check me-1"></i>Features
                                        <span class="badge bg-primary rounded-pill ms-1">@plan.Features.Count</span>
                                    </a>
                                </td>
                                <td>
                                    @if (plan.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-secondary" title="Edit Plan">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-danger" title="Delete Plan">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>