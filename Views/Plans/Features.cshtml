@model SubBill.Models.SubscriptionPlan
@{
    ViewData["Title"] = $"Features for {Model.Name}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Subscription Plans</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Name Features</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">
                <span class="badge bg-primary me-2">@Model.Name</span>Plan Features
            </h2>
            <small class="text-muted">Manage the entitlements, limits, and capabilities offered in this plan.</small>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Plans
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Feature List -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Active Features (@Model.Features.Count)</h5>
                    <span class="badge bg-light text-dark">Plan ID: #@Model.Id</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Features.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-stars display-4 d-block mb-3 text-secondary"></i>
                            <h5>No Features Configured</h5>
                            <p class="small">Add features on the right to show users what is included in this subscription plan.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Feature Name</th>
                                        <th style="width: 40%;">Feature Value / Limit</th>
                                        <th class="text-end" style="width: 25%;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var feature in Model.Features)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold text-dark">
                                                    <i class="bi bi-check2-circle text-success me-1"></i>@feature.FeatureName
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1 fs-6">
                                                    @feature.FeatureValue
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#editModal-@feature.Id">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                                <form asp-action="DeleteFeature" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove the feature \'@feature.FeatureName\'?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@feature.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                        <!-- Edit Modal for this feature -->
                                        <div class="modal fade" id="editModal-@feature.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="EditFeature" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@feature.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">Edit Feature</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold">Feature Name</label>
                                                                <input type="text" name="featureName" class="form-control" value="@feature.FeatureName" required maxlength="100" />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold">Feature Value / Limit</label>
                                                                <input type="text" name="featureValue" class="form-control" value="@feature.FeatureValue" maxlength="100" placeholder="e.g. 50GB, Unlimited, Yes" />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add Feature Form -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Add New Feature</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddFeature" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Feature Name <span class="text-danger">*</span></label>
                            <input type="text" name="featureName" class="form-control" placeholder="e.g. Team Members, Projects, SLA" required maxlength="100" />
                            <small class="text-muted">Must be unique within this plan.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Feature Value / Entitlement</label>
                            <input type="text" name="featureValue" class="form-control" placeholder="e.g. 10 Users, 50GB, Yes, 99.9%" maxlength="100" />
                            <small class="text-muted">Displayed to users on pricing & checkout.</small>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success fw-semibold">
                                <i class="bi bi-plus-lg me-1"></i>Add Feature to @Model.Name
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light p-3 small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Features will immediately be reflected on the user pricing page and subscription confirmations.
                </div>
            </div>
        </div>
    </div>
</div>
