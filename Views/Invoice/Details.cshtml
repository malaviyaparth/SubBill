@model SubBill.Models.Invoice
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Invoices</a>
        <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary">
            Download PDF
        </a>
    </div>

    <div class="card shadow-sm border-0 p-4">
        <div class="card-body">
            <div class="row border-bottom pb-4 mb-4">
                <div class="col-sm-6">
                    <h2 class="text-primary fw-bold">SubBill</h2>
                    <p class="text-muted mb-0">Subscription & Billing Platform</p>
                    <p class="text-muted">support@subbill.com</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h3 class="text-uppercase fw-bold">TAX INVOICE</h3>
                    <p class="mb-1"><strong>Invoice Number:</strong> @Model.InvoiceNumber</p>
                    <p class="mb-1"><strong>Date:</strong> @Model.InvoiceDate.ToString("dd MMMM yyyy")</p>
                    <p class="mb-0">
                        <strong>Status:</strong>
                        <span class="badge @(Model.Status == SubBill.Models.InvoiceStatus.Paid ? "bg-success" : "bg-warning text-dark")">
                            @Model.Status
                        </span>
                    </p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="text-muted text-uppercase fw-bold">Billed To:</h6>
                    <h5 class="fw-bold mb-1">@(Model.User?.FullName ?? Model.User?.UserName ?? "Valued Customer")</h5>
                    <p class="text-muted mb-0">@Model.User?.Email</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="text-muted text-uppercase fw-bold">Payment Information:</h6>
                    <p class="mb-1"><strong>Gateway:</strong> @(Model.Payment?.PaymentGateway ?? "Online Gateway")</p>
                    <p class="mb-1"><strong>Order ID:</strong> @(Model.Payment?.OrderId ?? "N/A")</p>
                    <p class="mb-0"><strong>Transaction Ref:</strong> @(Model.Payment?.PaymentId ?? "N/A")</p>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Billing Cycle</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong>@(Model.Subscription?.Plan?.Name ?? "Subscription") Plan</strong>
                                <div class="text-muted small">Access to platform services</div>
                            </td>
                            <td>@(Model.Subscription?.Plan?.BillingCycle.ToString() ?? "Monthly")</td>
                            <td class="text-end">@Model.Currency @Model.Amount.ToString("F2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5">
                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted">Subtotal (Net):</td>
                            <td class="text-end">@Model.Currency @Model.Amount.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">GST / Tax (18%):</td>
                            <td class="text-end">@Model.Currency @Model.TaxAmount.ToString("F2")</td>
                        </tr>
                        <tr class="border-top">
                            <td class="fw-bold fs-5">Total Paid:</td>
                            <td class="text-end fw-bold fs-5 text-primary">@Model.Currency @Model.TotalAmount.ToString("F2")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
