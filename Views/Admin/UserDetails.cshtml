@model SubBill.Models.AdminUserDetailsViewModel
@{
    ViewData["Title"] = $"User: {Model.User.Email}";
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="mb-1">
                <a asp-action="Users" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Back to Users
                </a>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">
                User Profile: @(string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.Email : Model.User.FullName)
            </h1>
        </div>
        <div class="mt-2 mt-sm-0 d-flex gap-2">
            <button type="button" class="btn btn-sm @(Model.IsDisabled ? "btn-success" : "btn-outline-danger")"
                    data-bs-toggle="modal"
                    data-bs-target="#toggleStatusModal">
                <i class="bi @(Model.IsDisabled ? "bi-unlock" : "bi-lock") me-1"></i>
                @(Model.IsDisabled ? "Enable Account" : "Disable Account")
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- User Information Card -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-4">
                <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                    <i class="bi bi-person-badge text-primary me-2"></i>Account Overview
                </h5>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase">Full Name</label>
                    <div class="fw-bold text-dark fs-6">@(string.IsNullOrWhiteSpace(Model.User.FullName) ? "None specified" : Model.User.FullName)</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase">Email Address</label>
                    <div class="fw-bold text-dark">@Model.User.Email</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase">System Role</label>
                    <div><span class="badge @(Model.Role == "Admin" ? "bg-dark" : "bg-primary")">@Model.Role</span></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase">Account Status</label>
                    <div>
                        @if (Model.IsDisabled)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                <i class="bi bi-lock me-1"></i>Locked / Disabled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border border-success">
                                <i class="bi bi-check-circle me-1"></i>Active / In Good Standing
                            </span>
                        }
                    </div>
                </div>
                <div class="mb-0">
                    <label class="text-muted small text-uppercase">User ID</label>
                    <div><code class="small text-muted">@Model.User.Id</code></div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 h-100 p-4">
                <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                    <i class="bi bi-stars text-warning me-2"></i>Current Active Subscription
                </h5>
                @if (Model.ActiveSubscription == null)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-x-circle fs-2"></i>
                        <p class="mt-2 mb-0">This user currently has no active subscription.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Plan</label>
                            <div class="fs-4 fw-bold text-primary">@Model.ActiveSubscription.Plan?.Name</div>
                            <small class="text-muted">₹@Model.ActiveSubscription.Plan?.Price.ToString("F2") / @Model.ActiveSubscription.Plan?.BillingCycle</small>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Subscription Status</label>
                            <div>
                                <span class="badge bg-success fs-6">@Model.ActiveSubscription.Status</span>
                                @if (Model.ActiveSubscription.AutoRenew)
                                {
                                    <span class="badge bg-light text-dark border ms-1">Auto-Renew ON</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark ms-1">Auto-Renew OFF</span>
                                }
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Current Period</label>
                            <div class="fw-semibold">
                                @Model.ActiveSubscription.CurrentPeriodStart.ToString("dd MMM yyyy") &mdash; @Model.ActiveSubscription.CurrentPeriodEnd.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase">Subscription ID</label>
                            <div>
                                <a asp-action="SubscriptionDetails" asp-route-id="@Model.ActiveSubscription.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>View Subscription Details (#@Model.ActiveSubscription.Id)
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TABS: Subscriptions, Payments, Invoices, Coupons -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom pt-3 pb-0 px-4">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#userSubsTab" type="button">
                        <i class="bi bi-box-seam me-1"></i>Subscriptions (@Model.Subscriptions.TotalCount)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#userPaymentsTab" type="button">
                        <i class="bi bi-credit-card me-1"></i>Payment History (@Model.Payments.TotalCount)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#userInvoicesTab" type="button">
                        <i class="bi bi-receipt me-1"></i>Invoices (@Model.Invoices.TotalCount)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#userCouponsTab" type="button">
                        <i class="bi bi-tag me-1"></i>Coupon Redemptions (@Model.CouponUsages.TotalCount)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-0">
            <div class="tab-content">
                <!-- Subscriptions Tab -->
                <div class="tab-pane fade show active p-4" id="userSubsTab">
                    @if (!Model.Subscriptions.Items.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">No subscriptions on record for this user.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Plan</th>
                                        <th>Status</th>
                                        <th>Period Start</th>
                                        <th>Period End</th>
                                        <th>Auto-Renew</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.Subscriptions.Items)
                                    {
                                        <tr>
                                            <td>#@s.Id</td>
                                            <td><strong>@s.Plan?.Name</strong></td>
                                            <td><span class="badge bg-secondary">@s.Status</span></td>
                                            <td>@s.CurrentPeriodStart.ToString("dd MMM yyyy")</td>
                                            <td>@s.CurrentPeriodEnd.ToString("dd MMM yyyy")</td>
                                            <td>@(s.AutoRenew ? "Yes" : "No")</td>
                                            <td class="text-end">
                                                <a asp-action="SubscriptionDetails" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Payments Tab -->
                <div class="tab-pane fade p-4" id="userPaymentsTab">
                    @if (!Model.Payments.Items.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">No payments made by this user.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Payment ID</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Payments.Items)
                                    {
                                        <tr>
                                            <td><code>@p.OrderId</code></td>
                                            <td><code>@(p.PaymentId ?? "-")</code></td>
                                            <td><strong>@p.Currency @p.Amount.ToString("F2")</strong></td>
                                            <td>
                                                <span class="badge @(p.Status == SubBill.Models.PaymentStatus.Success ? "bg-success" : "bg-danger")">
                                                    @p.Status
                                                </span>
                                            </td>
                                            <td>@p.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Invoices Tab -->
                <div class="tab-pane fade p-4" id="userInvoicesTab">
                    @if (!Model.Invoices.Items.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">No invoices issued to this user.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice #</th>
                                        <th>Date</th>
                                        <th>Total Amount</th>
                                        <th>Status</th>
                                        <th class="text-end">Download</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inv in Model.Invoices.Items)
                                    {
                                        <tr>
                                            <td><strong>@inv.InvoiceNumber</strong></td>
                                            <td>@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                                            <td><strong>@inv.Currency @inv.TotalAmount.ToString("F2")</strong></td>
                                            <td><span class="badge bg-success">@inv.Status</span></td>
                                            <td class="text-end">
                                                <a asp-action="DownloadInvoice" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-download"></i> PDF
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Coupons Tab -->
                <div class="tab-pane fade p-4" id="userCouponsTab">
                    @if (!Model.CouponUsages.Items.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">This user has not redeemed any discount coupons.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Coupon Code</th>
                                        <th>Discount Applied</th>
                                        <th>Redeemed Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.CouponUsages.Items)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark border fs-6">@u.Coupon?.Code</span></td>
                                            <td><strong class="text-success">-₹@u.DiscountAmount.ToString("F2")</strong></td>
                                            <td>@u.UsedAt.ToString("dd MMM yyyy HH:mm") UTC</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Disable / Enable User -->
<div class="modal fade" id="toggleStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="ToggleUserStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.User.Id" />
                <input type="hidden" name="disable" value="@((!Model.IsDisabled).ToString().ToLower())" />

                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold">@(Model.IsDisabled ? "Enable User Account" : "Disable User Account")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark mb-3">
                        Are you sure you want to @(Model.IsDisabled ? "enable" : "disable and lock out") account <strong>@Model.User.Email</strong>?
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Audit Reason (Required):</label>
                        <input type="text" name="reason" class="form-control" placeholder="Specify reason for audit logs" required />
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn @(Model.IsDisabled ? "btn-success" : "btn-danger")">
                        @(Model.IsDisabled ? "Enable Account" : "Disable Account")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
