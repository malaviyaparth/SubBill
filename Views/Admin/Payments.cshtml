@model SubBill.Models.AdminPaymentListViewModel
@{
    ViewData["Title"] = "Payment Management";
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-credit-card text-primary me-2"></i>Payment Management
            </h1>
            <p class="text-muted small mb-0">Inspect gateway transactions, filter by status and date, search payment references.</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <span class="badge bg-light text-dark border px-3 py-2">
                Total Payments: <strong>@Model.Payments.TotalCount</strong>
            </span>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-light">
        <form method="get" asp-action="Payments" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Search</label>
                <input type="text" name="search" class="form-control form-control-sm bg-white" placeholder="Payment ID, Order ID, User..." value="@Model.Search" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm bg-white">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<SubBill.Models.PaymentStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control form-control-sm bg-white" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control form-control-sm bg-white" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Payments" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
            </div>
        </form>
    </div>

    <!-- Payments Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Payment ID</th>
                        <th>User</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date &amp; Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Payments.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-credit-card fs-1"></i>
                                <p class="mt-2 mb-0">No payment transactions found matching criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pay in Model.Payments.Items)
                        {
                            <tr>
                                <td><code>@pay.OrderId</code></td>
                                <td><code>@(pay.PaymentId ?? "-")</code></td>
                                <td>
                                    <div class="fw-bold">@(pay.User?.FullName ?? pay.User?.UserName ?? "User")</div>
                                    <small class="text-muted">@pay.User?.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(pay.Subscription?.Plan?.Name ?? "Plan")
                                    </span>
                                </td>
                                <td><strong>@pay.Currency @pay.Amount.ToString("F2")</strong></td>
                                <td>
                                    @if (pay.Status == SubBill.Models.PaymentStatus.Success)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else if (pay.Status == SubBill.Models.PaymentStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (pay.Status == SubBill.Models.PaymentStatus.Failed)
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@pay.Status</span>
                                    }
                                </td>
                                <td>
                                    <span>@pay.CreatedAt.ToString("dd MMM yyyy")</span>
                                    <small class="text-muted d-block">@pay.CreatedAt.ToString("HH:mm") UTC</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Payments.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @Model.Payments.PageIndex of @Model.Payments.TotalPages (Total: @Model.Payments.TotalCount)</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.Payments.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Payments" asp-route-page="@(Model.Payments.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.Payments.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Payments.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Payments" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.Payments.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Payments" asp-route-page="@(Model.Payments.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
