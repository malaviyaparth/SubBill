@model SubBill.Models.PaginatedList<SubBill.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">
                <i class="bi bi-shield-lock text-primary me-2"></i>Security &amp; Compliance Audit Logs
            </h1>
            <p class="text-muted small mb-0">Immutable records of administrative actions, account overrides, coupon modifications, and business rule enforcement.</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <span class="badge bg-light text-dark border px-3 py-2">
                Total Audit Entries: <strong>@Model.TotalCount</strong>
            </span>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 180px;">Timestamp</th>
                        <th style="width: 220px;">Administrator</th>
                        <th style="width: 180px;">Action</th>
                        <th style="width: 140px;">Entity</th>
                        <th>Details</th>
                        <th style="width: 130px;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted font-sans-serif">
                                <i class="bi bi-shield-check fs-1"></i>
                                <p class="mt-2 mb-0">No audit records logged yet.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td>@log.Timestamp.ToIst().ToString("yyyy-MM-dd hh:mm:ss tt") IST</td>
                                <td><strong>@log.AdminEmail</strong></td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary font-sans-serif">
                                        @log.Action
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary">@log.EntityType</span>
                                    @if (!string.IsNullOrEmpty(log.EntityId))
                                    {
                                        <code class="d-block small text-muted">#@log.EntityId</code>
                                    }
                                </td>
                                <td class="font-sans-serif text-dark">@(log.Details ?? "—")</td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(log.IpAddress) ? "Localhost" : log.IpAddress)</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted font-sans-serif">Page @Model.PageIndex of @Model.TotalPages (Total: @Model.TotalCount logs)</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="AuditLogs" asp-route-page="@(Model.PageIndex - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="AuditLogs" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="AuditLogs" asp-route-page="@(Model.PageIndex + 1)">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
