@model List<SubBill.Models.SubscriptionHistory>
@{
    ViewData["Title"] = "Admin - Subscription Changes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Subscription Transitions (Admin)</h2>
        <a asp-controller="Plans" asp-action="Index" class="btn btn-outline-secondary">Manage Plans</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <p class="text-muted mb-0">No subscription transitions found across all users.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Old Plan</th>
                            <th>New Plan</th>
                            <th>Change Type</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in Model)
                        {
                            <tr>
                                <td>@history.Id</td>
                                <td>
                                    <div>@(history.Subscription?.User?.FullName ?? "N/A")</div>
                                    <small class="text-muted">@(history.Subscription?.User?.Email ?? history.Subscription?.UserId)</small>
                                </td>
                                <td>@history.OldPlan?.Name</td>
                                <td><strong>@history.NewPlan?.Name</strong></td>
                                <td>
                                    @if (history.ChangeType == SubBill.Models.PlanChangeType.Upgrade)
                                    {
                                        <span class="badge bg-success">Upgrade</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Downgrade</span>
                                    }
                                </td>
                                <td>@history.ChangedAt.ToIst().ToString("dd MMM yyyy, hh:mm:ss tt") IST</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
