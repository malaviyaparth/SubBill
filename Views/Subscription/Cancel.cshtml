@model SubBill.Models.UserSubscription
@{
    ViewData["Title"] = "Cancel Subscription Confirmation";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">Cancel Subscription Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <h6 class="alert-heading fw-bold">Are you sure you want to cancel your subscription?</h6>
                        <p class="mb-0">
                            Your subscription to <strong>@Model.Plan?.Name</strong> will not renew automatically.
                            You will continue to have full access until <strong>@Model.CurrentPeriodEnd.ToString("dd MMMM yyyy")</strong>.
                        </p>
                    </div>

                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="reason" class="form-label fw-bold">Reason for cancellation (optional):</label>
                            <textarea id="reason" name="reason" rows="3" class="form-control" placeholder="Please let us know how we can improve..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="MySubscription" class="btn btn-secondary">Keep My Subscription</a>
                            <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
