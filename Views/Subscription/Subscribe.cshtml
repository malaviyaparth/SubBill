@model SubBill.Models.SubscriptionPlan
@{
    ViewData["Title"] = $"Subscribe to {Model.Name}";
    var canTakeTrial = ViewBag.CanTakeTrial as bool? ?? false;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 px-4 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Confirm Subscription</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-2">Selected Plan</span>
                        <h2 class="fw-bold text-dark">@Model.Name Plan</h2>
                        <h1 class="text-primary my-2 fw-extrabold">₹@Model.Price.ToString("F2") <span class="fs-6 text-muted fw-normal">/ @Model.BillingCycle</span></h1>
                        <p class="text-muted small">@Model.Description</p>
                    </div>

                    <!-- Plan Terms Box -->
                    <div class="border rounded-3 p-3 mb-4 bg-light">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Billing Cycle:</span>
                            <span class="fw-bold text-dark">@Model.BillingCycle</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Auto Renewal:</span>
                            <span class="badge bg-success-subtle text-success">Enabled (Cancel Anytime)</span>
                        </div>
                        @if (Model.TrialDays > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Trial Period:</span>
                                <span class="badge bg-info-subtle text-info-emphasis">@Model.TrialDays Days Free</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Cancellation:</span>
                            <span class="text-secondary small">Keep access until billing period ends</span>
                        </div>
                    </div>

                    <!-- Phase 2: Display Selected Plan Features -->
                    @if (Model.Features != null && Model.Features.Any())
                    {
                        <div class="card border-0 bg-white shadow-sm p-3 mb-4 rounded-3">
                            <h6 class="fw-bold text-dark mb-2 small text-uppercase tracking-wider">Features Included with @Model.Name:</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var feature in Model.Features)
                                {
                                    <li class="d-flex align-items-center mb-2 small text-dark">
                                        <i class="bi bi-check-circle-fill text-success me-2 flex-shrink-0"></i>
                                        <span><strong>@feature.FeatureName</strong>: <span class="text-secondary">@feature.FeatureValue</span></span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Action Flow -->
                    <div class="d-grid gap-2">
                        @if (canTakeTrial && Model.TrialDays > 0)
                        {
                            <!-- Phase 10: Free Trial Start Button -->
                            <form asp-action="StartTrial" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow-sm mb-2">
                                    <i class="bi bi-gift-fill me-2"></i>Start @Model.TrialDays-Day Free Trial (No Card Needed)
                                </button>
                            </form>
                        }

                        <!-- Primary: Goes through Phase 4 Payment Gateway flow -->
                        <form asp-action="Subscribe" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn @(canTakeTrial && Model.TrialDays > 0 ? "btn-outline-primary" : "btn-primary btn-lg py-3") w-100 fw-bold shadow-sm mb-2">
                                <i class="bi bi-credit-card me-2"></i>Proceed to Payment Checkout
                            </button>
                        </form>

                        <!-- Direct activation for sandbox testing -->
                        <form asp-action="DirectSubscribe" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                Instant Activate (Developer Sandbox Mode)
                            </button>
                        </form>

                        <a asp-action="Index" class="btn btn-link text-secondary text-center mt-2 small">
                            <i class="bi bi-arrow-left me-1"></i>Back to All Plans
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>