@model List<SubBill.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Change Subscription Plan";
    var currentSub = ViewBag.CurrentSubscription as SubBill.Models.UserSubscription;
}

<div class="container py-4">
    <div class="mb-4">
        <h2>Change Your Subscription Plan</h2>
        <p class="text-muted">Compare available plans and choose to upgrade or downgrade your active subscription.</p>
    </div>

    @if (currentSub != null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
            <div>
                <strong>Current Active Plan:</strong> @currentSub.Plan?.Name (@currentSub.Plan?.Price.ToString("C") / @currentSub.Plan?.BillingCycle)
            </div>
            <a asp-action="MySubscription" class="btn btn-sm btn-outline-primary">Back to My Subscription</a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        @foreach (var plan in Model)
        {
            var isCurrent = currentSub != null && currentSub.PlanId == plan.Id;
            var isUpgrade = currentSub != null && plan.Price > (currentSub.Plan?.Price ?? 0);
            var isDowngrade = currentSub != null && plan.Price < (currentSub.Plan?.Price ?? 0);

            <div class="col">
                <div class="card h-100 shadow-sm border-0 @(isCurrent ? "border-primary border-2" : "")">
                    <div class="card-header bg-transparent py-3 text-center @(isCurrent ? "bg-primary text-white" : "")">
                        <h4 class="card-title my-0 fw-bold">@plan.Name</h4>
                        @if (isCurrent)
                        {
                            <span class="badge bg-light text-primary mt-1">CURRENT PLAN</span>
                        }
                        else if (isUpgrade)
                        {
                            <span class="badge bg-success mt-1">UPGRADE</span>
                        }
                        else if (isDowngrade)
                        {
                            <span class="badge bg-warning text-dark mt-1">DOWNGRADE</span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column text-center p-4">
                        <h1 class="card-title pricing-card-title mb-3">
                            @plan.Price.ToString("C")
                            <small class="text-muted fw-light fs-6">/ @plan.BillingCycle</small>
                        </h1>
                        <p class="card-text text-muted mb-4">@plan.Description</p>

                        <div class="mt-auto">
                            @if (isCurrent)
                            {
                                <button type="button" class="btn btn-secondary w-100 disabled">Current Plan</button>
                            }
                            else
                            {
                                <form asp-action="ConfirmChangePlan" method="post" onsubmit="return confirm('Are you sure you want to change to the @plan.Name plan?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="newPlanId" value="@plan.Id" />
                                    <button type="submit" class="btn @(isUpgrade ? "btn-success" : "btn-warning") w-100">
                                        @(isUpgrade ? "Upgrade to " + plan.Name : "Downgrade to " + plan.Name)
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
