@model SubBill.Models.UserSubscription
@{
    ViewData["Title"] = "My Subscription";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Subscription</h2>
        <div>
            <a asp-action="History" class="btn btn-outline-secondary me-2">Subscription History</a>
            <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-info me-2">My Invoices</a>
            <a asp-controller="Payment" asp-action="History" class="btn btn-outline-dark">Payment History</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null)
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <div class="card-body">
                <i class="bi bi-x-circle text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3">No Active Subscription</h4>
                <p class="text-muted">You currently do not have an active subscription plan.</p>
                <a asp-action="Index" class="btn btn-primary mt-2">Browse Subscription Plans</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-primary">Current Plan Details</h5>
                        @if (Model.Status == SubBill.Models.SubscriptionStatus.Active)
                        {
                            <span class="badge bg-success fs-6">Active</span>
                        }
                        else if (Model.Status == SubBill.Models.SubscriptionStatus.Trialing)
                        {
                            <span class="badge bg-info fs-6">Trial</span>
                        }
                        else if (Model.Status == SubBill.Models.SubscriptionStatus.Cancelled)
                        {
                            <span class="badge bg-warning text-dark fs-6">Cancelled (Access until period end)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                        }
                    </div>
                    <div class="card-body p-4">
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Plan Name</div>
                            <div class="col-sm-7 fw-bold fs-5">@Model.Plan?.Name</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Price</div>
                            <div class="col-sm-7 fw-bold">@Model.Plan?.Price.ToString("C") / @Model.Plan?.BillingCycle</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Billing Cycle</div>
                            <div class="col-sm-7">@Model.Plan?.BillingCycle</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Current Period</div>
                            <div class="col-sm-7">
                                @Model.CurrentPeriodStart.ToString("dd MMM yyyy") &mdash; @Model.CurrentPeriodEnd.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Auto Renewal</div>
                            <div class="col-sm-7">
                                @if (Model.AutoRenew)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Disabled (Expires on @Model.CurrentPeriodEnd.ToString("dd MMM yyyy"))</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-5 text-muted">Next Billing Date</div>
                            <div class="col-sm-7">
                                @(Model.AutoRenew ? Model.CurrentPeriodEnd.ToString("dd MMM yyyy") : "N/A (Cancelled)")
                            </div>
                        </div>
                        @if (Model.CancelledAt.HasValue)
                        {
                            <div class="alert alert-warning mt-3">
                                <strong>Cancelled on:</strong> @Model.CancelledAt.Value.ToString("dd MMM yyyy HH:mm") UTC<br />
                                <strong>Reason:</strong> @(Model.CancellationReason ?? "None provided")<br />
                                <em>Your access remains active until <strong>@Model.CurrentPeriodEnd.ToString("dd MMM yyyy")</strong>.</em>
                            </div>
                        }

                        <hr class="my-4" />

                        <div class="d-flex gap-2">
                            <a asp-action="ChangePlan" class="btn btn-outline-primary">
                                Change Plan (Upgrade / Downgrade)
                            </a>

                            @if (Model.Status == SubBill.Models.SubscriptionStatus.Active && Model.AutoRenew)
                            {
                                <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                    Cancel Subscription
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-4 bg-light">
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-muted fw-bold mb-3">Subscription FAQ</h6>
                        <h6>How do billing cycles work?</h6>
                        <p class="text-muted small">Subscriptions are billed either monthly, quarterly, or yearly depending on your chosen plan.</p>

                        <h6>What happens if I cancel?</h6>
                        <p class="text-muted small">Cancellation turns off auto-renewal. Your subscription remains active and accessible until the end of your prepaid period.</p>

                        <h6>Can I change plans?</h6>
                        <p class="text-muted small">Yes! You can upgrade or downgrade anytime through the "Change Plan" option.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>