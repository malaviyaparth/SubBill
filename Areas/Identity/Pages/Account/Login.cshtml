@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-11 col-xl-10">
            <div class="card auth-card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Left Brand / Feature Showcase Column (Desktop) -->
                    <div class="col-lg-5 auth-sidebar p-4 p-xl-5 text-white d-none d-lg-flex flex-column justify-content-between position-relative">
                        <div>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center text-decoration-none text-white mb-4">
                                <div class="bg-white bg-opacity-20 p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="bi bi-wallet2 text-white fs-4"></i>
                                </div>
                                <span class="fs-4 fw-bold tracking-tight">SubBill</span>
                            </a>

                            <div class="mb-4">
                                <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 small fw-semibold mb-3">
                                    <i class="bi bi-stars me-1"></i>Next-Gen Billing Platform
                                </span>
                                <h3 class="fw-bold mb-2">Automate Your SaaS Revenue</h3>
                                <p class="text-white text-opacity-75 small">
                                    Empowering modern businesses with recurring billing cycles, automated GST tax invoicing, and seamless customer lifecycle management.
                                </p>
                            </div>

                            <div class="d-flex flex-column gap-3 mb-4">
                                <div class="auth-feature-pill d-flex align-items-center">
                                    <div class="bg-info bg-opacity-20 text-info rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-receipt fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Automated GST Invoicing</div>
                                        <div class="text-white text-opacity-75" style="font-size: 0.76rem;">QuestPDF tax invoices with SAC 998313 schedule</div>
                                    </div>
                                </div>

                                <div class="auth-feature-pill d-flex align-items-center">
                                    <div class="bg-success bg-opacity-20 text-success rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-arrow-repeat fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Subscription Lifecycle</div>
                                        <div class="text-white text-opacity-75" style="font-size: 0.76rem;">Instant upgrades, downgrades, and trial automation</div>
                                    </div>
                                </div>

                                <div class="auth-feature-pill d-flex align-items-center">
                                    <div class="bg-warning bg-opacity-20 text-warning rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-shield-check fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">Tamper-Proof Security</div>
                                        <div class="text-white text-opacity-75" style="font-size: 0.76rem;">HMAC-SHA256 verification and sandbox idempotency</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-top border-white border-opacity-10 d-flex align-items-center text-white text-opacity-75 small">
                            <i class="bi bi-shield-lock-fill text-warning me-2 fs-5"></i>
                            <span>256-Bit SSL Encrypted &bull; Secure Authentication</span>
                        </div>
                    </div>

                    <!-- Right Form Column -->
                    <div class="col-lg-7 p-4 p-md-5 bg-white d-flex flex-column justify-content-center">
                        <!-- Mobile Brand Header -->
                        <div class="d-lg-none text-center mb-4">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center text-decoration-none text-primary">
                                <i class="bi bi-wallet2 fs-2 me-2"></i>
                                <span class="fs-3 fw-bold">SubBill</span>
                            </a>
                        </div>

                        <div class="mb-4">
                            <h2 class="fw-bold text-dark mb-1">Welcome back</h2>
                            <p class="text-muted small mb-0">Sign in to your account to manage your plans and billing.</p>
                        </div>

                        <!-- One-Click Demo Credentials Quick Fill Box -->
                        <div class="demo-account-box mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="small fw-bold text-dark">
                                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Demo Accounts
                                </span>
                                <span class="text-muted" style="font-size: 0.75rem;">Click to auto-fill</span>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-primary demo-chip-btn" onclick="fillCredentials('admin@subscription.com', 'Admin@123')">
                                    <i class="bi bi-shield-lock me-1"></i>Admin Demo
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary demo-chip-btn" onclick="fillCredentials('user@subscription.com', 'User@123')">
                                    <i class="bi bi-person me-1"></i>User Demo
                                </button>
                            </div>
                        </div>

                        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 rounded-3 small mb-3" role="alert"></div>

                            <!-- Email Field -->
                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label small fw-semibold text-dark mb-1">Email Address</label>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Input.Email" id="emailInput" class="form-control border-start-0" placeholder="name@company.com" autocomplete="username" aria-required="true" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="Input.Password" class="form-label small fw-semibold text-dark mb-0">Password</label>
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-primary small text-decoration-none">Forgot password?</a>
                                </div>
                                <div class="input-group auth-input-group">
                                    <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Input.Password" id="passwordInput" type="password" class="form-control border-start-0 border-end-0" placeholder="Enter your password" autocomplete="current-password" aria-required="true" />
                                    <button type="button" class="btn toggle-password-btn border-start-0" onclick="togglePasswordVisibility('passwordInput', 'togglePasswordIcon')" title="Toggle password visibility">
                                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Remember Me Checkbox -->
                            <div class="form-check mb-4">
                                <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                                <label class="form-check-label small text-secondary" for="rememberMeCheck">
                                    Keep me signed in on this device
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <button id="login-submit" type="submit" class="btn btn-primary w-100 auth-submit-btn shadow-sm mb-3">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to SubBill
                            </button>

                            <!-- External Logins (if configured) -->
                            @{
                                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                                {
                                    <div class="position-relative my-4 text-center">
                                        <hr class="text-muted opacity-25" />
                                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">or continue with</span>
                                    </div>
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary w-100 py-2 rounded-3" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                                @provider.DisplayName
                                            </button>
                                        }
                                    </form>
                                }
                            }

                            <!-- Switch to Register -->
                            <div class="text-center pt-3 border-top mt-3 text-muted small">
                                Don't have an account yet?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none ms-1">
                                    Create a free account
                                </a>
                            </div>

                            <!-- Back to Home -->
                            <div class="text-center mt-3">
                                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-secondary small text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Homepage
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, password) {
            const emailInput = document.getElementById('emailInput');
            const passwordInput = document.getElementById('passwordInput');
            if (emailInput && passwordInput) {
                emailInput.value = email;
                passwordInput.value = password;

                // Brief visual feedback
                emailInput.classList.add('bg-primary-subtle');
                passwordInput.classList.add('bg-primary-subtle');
                setTimeout(() => {
                    emailInput.classList.remove('bg-primary-subtle');
                    passwordInput.classList.remove('bg-primary-subtle');
                }, 300);

                const submitBtn = document.getElementById('login-submit');
                if (submitBtn) {
                    submitBtn.focus();
                }
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}